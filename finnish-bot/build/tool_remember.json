   {
    "id": "216a7005-ea7d-521f-90bb-209d9cfafab6",
    "name": "Logic",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     720,
     0
    ],
    "parameters": {
     "mode": "runOnceForAllItems",
     "jsCode": "const TZ = 'Europe/Helsinki';\nconst body = (n) => { try { const j = $(n).first().json; return j.statusCode === 200 ? String(j.body || '') : ''; } catch (e) { return ''; } };\nconst parse = (s, d) => { try { const v = JSON.parse(s); return v || d; } catch (e) { return d; } };\nconst now = $now.setZone(TZ);\nconst ymd = (n) => now.plus({ days: n }).toFormat('yyyy-LL-dd');\nconst g = $('Load').first().json;\nlet state = { notes: [] };\nif (g.statusCode === 200) { try { const s = JSON.parse(g.body); if (s && Array.isArray(s.notes)) state = s; } catch (e) {} }\nconst note = String($('When called').first().json.note || '').trim().slice(0, 400);\nif (!note) throw new Error('note is empty');\nstate.notes.push({ date: ymd(0), text: note });\nstate.notes = state.notes.slice(-200);\nreturn [{ json: { result: 'Saved note.', payload: JSON.stringify(state, null, 1) } }];\n"
    }
   },
