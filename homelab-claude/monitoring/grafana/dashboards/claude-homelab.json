{
 "uid": "claude-homelab",
 "title": "Claude homelab",
 "tags": [
  "claude"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "id": 100,
   "type": "row",
   "title": "Claude Code: all sessions (interactive, Remote Control, jobs)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 1,
   "type": "stat",
   "title": "Tokens, last 24h",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase({__name__=~\"claude_code_token_usage.*\"}[24h]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Cache-read share, 24h (higher = cheaper)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase({__name__=~\"claude_code_token_usage.*\",type=\"cacheRead\"}[24h])) / sum(increase({__name__=~\"claude_code_token_usage.*\"}[24h]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Est. list-price cost, 24h (Pro is flat; use as weight)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase({__name__=~\"claude_code_cost_usage.*\"}[24h]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Sessions started, 24h",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase({__name__=~\"claude_code_session_count.*\"}[24h]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Tokens per hour by type",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (increase({__name__=~\"claude_code_token_usage.*\"}[1h]))",
     "legendFormat": "{{type}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "interval": "1h"
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Tokens per hour by model",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model) (increase({__name__=~\"claude_code_token_usage.*\"}[1h]))",
     "legendFormat": "{{model}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "interval": "1h"
  },
  {
   "id": 113,
   "type": "row",
   "title": "Automation flow: claude-runner jobs",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Job runs today (vs daily cap)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(claude_job_runs_today)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Failed / timed-out jobs, 24h",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 14,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(claude_job_runs_total{status!=\"ok\"}[24h])) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 9,
   "type": "stat",
   "title": "Job running now",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(claude_job_running)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 10,
   "type": "bargauge",
   "title": "Hours since each job last finished",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 14,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(time() - claude_job_last_finish_timestamp_seconds) / 3600",
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "h"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Job runs per hour by job/status",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job, status) (increase(claude_job_runs_total[1h]))",
     "legendFormat": "{{job}} {{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "interval": "1h"
  },
  {
   "id": 12,
   "type": "bargauge",
   "title": "Tokens per job, last 7d",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (increase(claude_job_tokens_total[7d]))",
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  }
 ]
}