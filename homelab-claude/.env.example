# Copy to .env (chmod 600 .env). Never commit the real .env.

# Where ALL Claude data lives on the homelab (one folder = one thing to back up)
DATA_ROOT=/srv/claude
PUID=1000
PGID=1000
TZ=Europe/Helsinki

# Name shown in the Claude app's session list and the tmux prompt
CLAUDE_HOSTNAME=homelab
# Your tailnet name for this machine, e.g. homelab.tail1234.ts.net (from `tailscale status`)
TS_FQDN=homelab.example.ts.net

# Pin a version for reproducible rebuilds (e.g. 2.1.330); "latest" = newest on rebuild
CLAUDE_CODE_VERSION=latest

# Automation runner (n8n -> claude-box:8787). Generate with: openssl rand -hex 32
RUNNER_TOKEN=
# Safety net for your Pro limits: max automated runs per day (all jobs together)
JOB_MAX_RUNS_PER_DAY=40
# Seconds before a job is killed
JOB_TIMEOUT=900
# Default model for jobs: haiku is cheapest; jobs can override per script
JOB_MODEL=haiku

# Home Assistant MCP (Settings > Devices & services > Add "Model Context Protocol Server";
# then Profile > Security > Long-lived access token)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

GRAFANA_ADMIN_PASSWORD=
N8N_VERSION=latest

# IMPORTANT: do NOT set ANTHROPIC_API_KEY anywhere. If it is set, `claude -p` bills the
# API instead of your Claude Pro plan, and Remote Control refuses API keys.
